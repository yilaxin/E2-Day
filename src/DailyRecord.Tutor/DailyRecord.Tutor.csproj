<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>E2Day.Tutor</AssemblyName>
    <RootNamespace>DailyRecord.App</RootNamespace>
    <Product>E²-Day Teacher</Product>
    <AssemblyTitle>E²-Day Teacher</AssemblyTitle>
    <Description>记录每一堂课，看见每一步成长</Description>
    <ApplicationIcon>Assets/e2-day-tutor.ico</ApplicationIcon>
    <Version>1.0.5</Version>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DailyRecord.Core/DailyRecord.Core.csproj" />
    <Compile Include="../DailyRecord.App/SmoothWheelScroller.cs" Link="Shared/SmoothWheelScroller.cs" />
    <Compile Include="../DailyRecord.App/Ui.cs" Link="Shared/Ui.cs" />
    <Compile Include="../DailyRecord.App/NoteImages.cs" Link="Shared/NoteImages.cs" />
    <Compile Include="../DailyRecord.App/LocalSecrets.cs" Link="Shared/LocalSecrets.cs" />
    <Resource Include="Assets/e2-day-logo.png" />
    <Content Include="Assets/e2-day-tutor.ico" Link="e2-day-tutor.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../data/holidays/*.json" Link="Data/Holidays/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../data/holidays/LICENSE" Link="Data/Holidays/LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
