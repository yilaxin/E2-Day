<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>DailyRecord</AssemblyName>
    <RootNamespace>DailyRecord.App</RootNamespace>
    <Product>E²-Day</Product>
    <AssemblyTitle>E²-Day</AssemblyTitle>
    <Description>Explore Everyday Day · 探索每一天</Description>
    <ApplicationIcon>Assets/e2-day.ico</ApplicationIcon>
    <Version>1.0.6</Version>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/e2-day-logo.png" />
    <Resource Include="Assets/e2-day.ico" />
    <Content Include="Assets/e2-day.ico" Link="e2-day.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../DailyRecord.Core/DailyRecord.Core.csproj" />
    <Content Include="../../data/holidays/*.json" Link="Data/Holidays/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../data/holidays/LICENSE" Link="Data/Holidays/LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
